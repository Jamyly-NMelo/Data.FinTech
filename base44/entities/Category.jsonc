{
  "name": "Category",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "income",
        "expense"
      ],
      "default": "expense"
    },
    "group": {
      "type": "string",
      "enum": [
        "receita",
        "custos",
        "operacional",
        "financeiro",
        "prolabore",
        "pessoal",
        "impostos",
        "patrimonio",
        "nao_classificado"
      ],
      "default": "operacional"
    },
    "environment": {
      "type": "string",
      "enum": [
        "pf",
        "pj",
        "invest"
      ],
      "default": "pf"
    },
    "color": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "kind"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}