{
  "name": "Preferences",
  "type": "object",
  "properties": {
    "theme": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ],
      "default": "system"
    },
    "privacy_mode": {
      "type": "boolean",
      "default": false
    },
    "active_environment": {
      "type": "string",
      "enum": [
        "pf",
        "pj",
        "invest",
        "consolidado"
      ],
      "default": "pf"
    },
    "currency": {
      "type": "string",
      "default": "BRL"
    },
    "agenda_days": {
      "type": "number",
      "default": 10
    },
    "projection_months": {
      "type": "number",
      "default": 12
    }
  },
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}