{
  "name": "TaxScenario",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "activity": {
      "type": "string",
      "enum": [
        "comercio",
        "servicos",
        "industria",
        "misto"
      ],
      "default": "servicos"
    },
    "service_annex": {
      "type": "string",
      "enum": [
        "I",
        "III",
        "V"
      ],
      "default": "III"
    },
    "monthly_revenue": {
      "type": "number",
      "default": 0
    },
    "annual_revenue": {
      "type": "number",
      "default": 0
    },
    "profit_margin_percent": {
      "type": "number",
      "default": 20
    },
    "payroll": {
      "type": "number",
      "default": 0
    },
    "iss_percent": {
      "type": "number",
      "default": 5
    },
    "mei_das": {
      "type": "number",
      "default": 76
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}