VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
VITE_CONTACT_EMAIL=
VITE_SITE_URL=https://datafintech.netlify.app
VITE_SITE_NAME=DataFintech
VITE_API_BASE_URL=/api

# Local development: the Vite server proxies /api to this gateway.
DEV_API_PROXY_TARGET=http://localhost:8080

# Gateway runtime only. Never prefix these values with VITE_.
APPS_SCRIPT_URL=https://script.google.com/macros/s/SEU_DEPLOYMENT_ID/exec
GOOGLE_CLIENT_ID=SEU_CLIENT_ID.apps.googleusercontent.com
GATEWAY_SECRET=REPLACE_WITH_A_RANDOM_SECRET
ALLOWED_ORIGINS=http://localhost:5173

# Netlify function runtime variable; configure with the deployed Cloud Run URL.
CLOUD_RUN_URL=https://YOUR_CLOUD_RUN_SERVICE.run.app
