{
  "name": "Debt",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "creditor": {
      "type": "string"
    },
    "environment": {
      "type": "string",
      "enum": [
        "pf",
        "pj",
        "invest"
      ],
      "default": "pf"
    },
    "principal": {
      "type": "number",
      "default": 0
    },
    "outstanding_balance": {
      "type": "number",
      "default": 0
    },
    "annual_interest_rate": {
      "type": "number",
      "default": 0
    },
    "future_interest": {
      "type": "number",
      "default": 0
    },
    "installment_amount": {
      "type": "number",
      "default": 0
    },
    "installments_total": {
      "type": "number",
      "default": 0
    },
    "installments_paid": {
      "type": "number",
      "default": 0
    },
    "start_date": {
      "type": "string",
      "format": "date"
    },
    "maturity_date": {
      "type": "string",
      "format": "date"
    },
    "term": {
      "type": "string",
      "enum": [
        "curto_prazo",
        "longo_prazo",
        "nao_classificado"
      ],
      "default": "nao_classificado"
    },
    "due_day": {
      "type": "number"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name",
    "outstanding_balance"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}