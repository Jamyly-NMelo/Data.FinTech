{
  "name": "InvestmentOperation",
  "type": "object",
  "properties": {
    "investment_id": {
      "type": "string"
    },
    "type": {
      "type": "string",
      "enum": [
        "aporte",
        "resgate",
        "dividendo",
        "jcp",
        "rendimento"
      ],
      "default": "aporte"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "price": {
      "type": "number",
      "default": 0
    },
    "fees": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "investment_id",
    "type",
    "date"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}