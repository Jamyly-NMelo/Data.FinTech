{
  "name": "Investment",
  "type": "object",
  "properties": {
    "name": {
      "type": "string"
    },
    "ticker": {
      "type": "string"
    },
    "asset_class": {
      "type": "string",
      "enum": [
        "renda_fixa",
        "acoes",
        "fii",
        "fundos",
        "cripto",
        "exterior",
        "outros"
      ],
      "default": "renda_fixa"
    },
    "environment": {
      "type": "string",
      "enum": [
        "pf",
        "pj",
        "invest"
      ],
      "default": "invest"
    },
    "institution": {
      "type": "string"
    },
    "quantity": {
      "type": "number",
      "default": 0
    },
    "avg_price": {
      "type": "number",
      "default": 0
    },
    "current_price": {
      "type": "number",
      "default": 0
    },
    "quote_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "name"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}